<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>VerifyHost</AssemblyName>
    <RootNamespace>VerifyHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PGvZNewPlantMod\PGvZNewPlantMod.csproj" />
  </ItemGroup>

  <Target Name="CopyPlantPlugins" AfterTargets="Build">
    <ItemGroup>
      <PlantPluginDll Include="..\..\src\PGvZNewPlantMod\bin\$(Configuration)\net6.0\PGvZNewPlantMod\plants\*.dll" />
      <StalePlantPluginDll Include="$(TargetDir)PGvZNewPlantMod\plants\*.dll"
                           Exclude="@(PlantPluginDll->'$(TargetDir)PGvZNewPlantMod\plants\%(Filename).dll')" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)PGvZNewPlantMod\plants" />
    <Copy SourceFiles="@(PlantPluginDll)"
          DestinationFolder="$(TargetDir)PGvZNewPlantMod\plants"
          SkipUnchangedFiles="true" />
    <Delete Files="@(StalePlantPluginDll)" />
  </Target>

  <ItemGroup>
    <Reference Include="Lawn">
      <HintPath>..\..\..\..\PlantGirlsVsZombies\LawnDLL\Lawn.dll</HintPath>
    </Reference>
    <Reference Include="IronPython">
      <HintPath>..\..\..\..\PlantGirlsVsZombies\LawnDLL\IronPython.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Scripting">
      <HintPath>..\..\..\..\PlantGirlsVsZombies\LawnDLL\Microsoft.Scripting.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>..\..\..\..\PlantGirlsVsZombies\LawnDLL\MonoMod.RuntimeDetour.dll</HintPath>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>..\..\..\..\PlantGirlsVsZombies\LawnDLL\MonoMod.Utils.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>..\..\..\..\PlantGirlsVsZombies\LawnDLL\Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>..\..\..\..\PlantGirlsVsZombies\LawnDLL\MonoGame.Framework.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
